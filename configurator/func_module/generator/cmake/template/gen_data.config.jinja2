{# blank line #}
#include "Os/rt_framework.config"
{%- for module_name in get_enable_module_list() %}
{%- if module_name == "Os"%}
CONFIG_RT_FRAMEWORK=y
{%- elif module_name == "MemPool"%}
CONFIG_RT_FRAMEWORK_MEMPOOL=y
{%- elif module_name == "Isolate"%}
CONFIG_RT_FRAMEWORK_ISOLATE=y
{%- else %}
CONFIG_MODULE_{{module_name.upper()}}=y
{%- endif %}
{%- endfor%}