################################################################################
#    File Generated by VCOS Studio
#    Do not move this file.
################################################################################
{%- set project_name = get_project_name() %}
export PROJECT_NAME := {{project_name}}
export APPLICATION_PATH := $(CURDIR)
export PROJECT := $(APPLICATION_PATH)
{%- set project_file_path = get_project_file_path() %}
export PROJECT_FILE_PATH := {{project_file_path}}

{%- set system_path = get_system_path() %}
# System Path relative to application directory
export SYSTEM_PATH := {{system_path}}

{%- set gendata_path = get_gendata_path() %}
export GENDATA_PATH := {{gendata_path}}

{%- set mcal_path = get_mcal_path() %}
# Mcal static source files
export  MCAL_PATH := {{mcal_path}}

{%- set mcal_gendate_path = get_mcal_gendate_path() %}
# mcal gendate path relative to application directory
export MCAL_GENDATA_PATH := {{mcal_gendate_path}}

{%- set template_path = get_template_path() %}
export TEMPLATE_PATH := ./{{template_path}}

{%- set target = get_target() %}
# Target chip selected.
export TARGET := {{target}}

{%- set compiler = get_compiler() %}
# Compiler selected.
export COMPILER := {{compiler}}

{%- set compiler_path = get_compiler_path() %}
# Compiler path.
export COMPILER_PATH = "{{compiler_path}}"

# include makefile configured by user.
-include makefile_config.mk
-include $(GENDATA_PATH)/makefile_generate.mk
{%- set tool_chain_path = get_tool_chain_path() %}
# toolchain path path.
export TOOLCHAIN_PATH := {{tool_chain_path}}

ifeq ($(OS),Windows_NT)
	export PYTHONPATH:=$(STUDIO_PATH)/third_party/site-packages-windows;$(STUDIO_PATH)/third_party/packages;$(STUDIO_PATH)
else
	export PYTHONPATH:=$(STUDIO_PATH)/third_party/site-packages-linux:$(STUDIO_PATH)/third_party/packages:$(STUDIO_PATH)
endif


include $(BUILD_TOOL_PATH)/Makefile

kconfig:
	make -C $(BUILD_TOOL_PATH) config

codegen_bsw:
	python $(STUDIO_PATH)/script_interface/auto_cli.py -p $(PROJECT_FILE_PATH)/$(PROJECT_NAME).vcosproject  Generate --force --module $(MODULE_LIST) $(CODEGEN_MODE)

codegen_swc:
	python $(STUDIO_PATH)/script_interface/auto_cli.py -p $(PROJECT_FILE_PATH)/$(PROJECT_NAME).vcosproject Swc_Generate --swcs $(SWC_LIST)

start_StudioUI:
	python $(STUDIO_PATH)/script_interface/studio.py

menuconfiglib:
	python $(STUDIO_PATH)/vcos_tools/Kconfiglib/genconfig.py --mode True --system $(SYSTEM_PATH) --gendata $(GENDATA_PATH)
