        if (ret != E_OK)
        {
            Rte_LogOs(SCHM_INIT_SERVICE_ID, RTE_DLOG_EMPTY_ID, OSServiceId_SetRelAlarm, OS_ALARM_{{alarm["name"]}}_ID, ret);
        }
        {%- endif %}
    {%- endfor %}
#else
    {%- for alarm in core_to_alarm_dict[core_id] %}
