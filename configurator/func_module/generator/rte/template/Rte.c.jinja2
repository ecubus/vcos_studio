        {
            Rte_LogOs(SCHM_INIT_SERVICE_ID, RTE_DLOG_EMPTY_ID, OSServiceId_ActivateTask, OS_TASK_{{task_name.upper()}}_ID, ret);
        }
        {%- endif %}
