        (void)ActivateTask((TaskType)OS_TASK_{{task_name.upper()}}_ID);
        {%- endif %}
        {%- endif %}
    {%- endfor %}
#endif
        /* activate the alarms used for TimingEvents */
    {%- if core_id in core_to_alarm_dict %}
