/* double include prevention */
#ifndef RTE_CBK_H
# define RTE_CBK_H

#include "Rte_Type.h"

#define RTE_START_SEC_CODE

#include "rte_memmap.h"

/*
 * COM Callbacks for Rx Indication
 */
{%- set com_cbk_dict_same_core, com_cbk_dict_inter_core = get_rte_com_cbk_dict() %}
{%- for signa_name, signal_info in com_cbk_dict_same_core.items() %}
FUNC(void, RTE_CODE) Rte_COMCbk_{{signa_name}}_Rx(void);
    {%- if signal_info["data_mapping_flag"]["is_timeout"] %}
FUNC(void, RTE_CODE) Rte_COMCbkRxTOut_{{signa_name}}_Rx(void);
    {%- endif %}
{%- endfor %}
{%- for signa_name, signal_info in com_cbk_dict_inter_core.items() %}
FUNC(void, RTE_CODE) Rte_COMCbk_{{signa_name}}_Rx(void);
    {%- if signal_info["data_mapping_flag"]["is_timeout"] %}
FUNC(void, RTE_CODE) Rte_COMCbkRxTOut_{{signa_name}}_Rx(void);
    {%- endif %}
{%- endfor %}

/*
 * RTE Schedulable entity for COM-Access from different partitions
 */
{%- for proxy_name in get_rte_com_tx_proxy_list() %}
FUNC(void, RTE_CODE) {{proxy_name}}(void);
{%- endfor %}

#define RTE_STOP_SEC_CODE
#include "rte_memmap.h"

#endif /* RTE_CBK_H */
