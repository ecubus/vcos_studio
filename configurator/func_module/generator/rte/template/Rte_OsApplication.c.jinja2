            }
        }
#else
        alarm = (AlarmType){{rport['alarm_id'].upper()}};
        (void)SetRelAlarm(alarm, RTE_MSEC_TO_TICKS({{rport['timeout']}}, {{rport['seconds_per_tick']}}), 0);
        do
        {
