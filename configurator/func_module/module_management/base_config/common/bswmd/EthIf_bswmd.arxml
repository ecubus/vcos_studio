                          <SHORT-NAME>EthIfPhysControllerRef</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Reference to a physical Ethernet controller, which is handled by the Ethernet Interface.</L-2>
                          </DESC>
                          <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_EthIf_00027</RELATED-TRACE-ITEM-REF>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
