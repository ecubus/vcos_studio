                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="1d289cfa-2d7e-40e9-9798-214ade89d71e">
                                      <SHORT-NAME>R</SHORT-NAME>
