                            <!-- Container Definition: OsMemoryRegionFlags -->
                            <ECUC-PARAM-CONF-CONTAINER-DEF UUID="cb5be6c7-1854-4801-ab95-f7e7de565bc1">
                              <SHORT-NAME>OsMemoryRegionFlags</SHORT-NAME>
                              <ADMIN-DATA>
                                <SDGS>
                                  <SDG GID="VCOS2:CfgPostBuild">
                                    <SD GID="VCOS2:postBuildNotDeletable">true</SD>
                                    <SD GID="VCOS2:postBuildSelectableChangeable">false</SD>
                                  </SDG>
                                </SDGS>
