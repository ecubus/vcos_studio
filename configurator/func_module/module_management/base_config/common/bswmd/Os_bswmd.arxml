                                      <SHORT-NAME>USER</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="c819dcfd-47ca-4bed-8723-b93b49404f39">
                                      <SHORT-NAME>PROTECTION_SET0</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="567dba65-c24e-4222-8f2e-59a434324275">
                                      <SHORT-NAME>PROTECTION_SET1</SHORT-NAME>
                                      <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF UUID="b10dc2f5-7702-4f5c-ac4c-b593996632ff">
