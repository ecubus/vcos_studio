                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Os/OsAlarm</DESTINATION-REF>
                    </ECUC-REFERENCE-DEF>
                    <ECUC-REFERENCE-DEF UUID="ECUC:4a2dbf82-5e24-4d1b-b778-6691fa1cde23">
                      <SHORT-NAME>OsAppCounterRef</SHORT-NAME>
