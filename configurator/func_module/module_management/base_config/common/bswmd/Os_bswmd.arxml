                      </LITERALS>
                    </ECUC-ENUMERATION-PARAM-DEF>
                    <ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:75a1986f-1458-49fb-9feb-b84c6e58956e">
                      <SHORT-NAME>OsEventJitterStatistics</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">This attribute specifies whether use event statistics.</L-2>
                      </DESC>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE">ECUC_Os_00046</RELATED-TRACE-ITEM-REF>
