                        </ECUC-STRING-PARAM-DEF>
                        <!-- PARAMETER DEFINITION: OsMemoryRegionIdentifier -->
                        <ECUC-INTEGER-PARAM-DEF UUID="2b6a26ff-3b81-4834-8468-2ccaf02ab6a0">
                          <SHORT-NAME>OsMemoryRegionIdentifier</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Defines the optional hardware specific memory protection region identifier.

    The interpretation of this parameter is hardware specific (e.g. PID, ProtectionSet or ASID).</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
