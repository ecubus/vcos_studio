                    <ECUC-INTEGER-PARAM-DEF UUID="ECUC:1369dbe1-88b9-4ff5-83d3-a62c5cf4106a">
                      <SHORT-NAME>OsNumberOfCores</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Maximum number of cores that are controlled by the OS.</L-2>
                      </DESC>
                      <ADMIN-DATA>
                        <SDGS>
                          <SDG GID="VCOS:CfgUnrealized">
