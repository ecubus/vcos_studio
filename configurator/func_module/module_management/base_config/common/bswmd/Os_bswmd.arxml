                  <UPPER-MULTIPLICITY>65535</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:8b7235cc-2457-4ec2-b3d1-586d7d798a50">
                      <SHORT-NAME>OsTaskWithProtection</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">true: task has private data section(task must be unprivileged).</L-2>
                      </DESC>
                      <INTRODUCTION>
                        <P>
                          <L-1 L="EN">false: task no private data section.</L-1>
                        </P>
                      </INTRODUCTION>
                      <RELATED-TRACE-ITEM-REF BASE="ArTrace" DEST="TRACEABLE"/>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
