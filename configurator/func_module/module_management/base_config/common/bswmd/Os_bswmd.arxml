                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: OsMemoryRegionAccessType -->
                                <ECUC-ENUMERATION-PARAM-DEF UUID="b925f873-7f97-4be6-9470-b748ac16e839">
                                  <SHORT-NAME>OsMemoryRegionAccessType</SHORT-NAME>
                                  <DESC>
