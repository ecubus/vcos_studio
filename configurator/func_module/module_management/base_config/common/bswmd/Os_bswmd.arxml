                    </ECUC-REFERENCE-DEF>
                    <ECUC-REFERENCE-DEF UUID="ECUC:ff388a32-96e2-44e3-852f-b565616152fb">
                      <SHORT-NAME>OsAppIsrRef</SHORT-NAME>
                      <DESC>
