                <ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:f5bf116f-a0a2-4a8b-9f6a-1b023e6d9a13">
                  <SHORT-NAME>OsAlarm</SHORT-NAME>
                  <DESC>
